### Localhost Environment

### Get all movies
GET http://localhost:3000/movies

### Get a movie by ID
GET http://localhost:3000/movies/{{movieId}}

### Get a movie by title
GET http://localhost:3000/movies/title/{{movieTitle}}

### Create a new movie
POST http://localhost:3000/movies
Content-Type: application/json

{
  "title": "Inception",
  "releasedate": "2010-07-16",
  "genre": "Sci-Fi",
  "rating": 8.8,
  "parentRating": "PG-13",
  "actors": ["Leonardo DiCaprio", "Joseph Gordon-Levitt", "Ellen Page"],
  "director": "Christopher Nolan"
}

### Update a movie by ID
PUT http://localhost:3000/movies/{{movieId}}
Content-Type: application/json

{
  "title": "Inception",
  "releasedate": "2010-07-16",
  "genre": "Sci-Fi",
  "rating": 8.8,
  "parentRating": "PG-13",
  "actors": ["Leonardo DiCaprio", "Joseph Gordon-Levitt", "Ellen Page"],
  "director": "Christopher Nolan"
}

### Delete a movie by ID
DELETE http://localhost:3000/movies/{{movieId}}

### Get all actors
GET http://localhost:3000/actors

### Get an actor by ID
GET http://localhost:3000/actors/{{actorId}}

### Get an actor by name
GET http://localhost:3000/actors/name?firstName={{firstName}}&lastName={{lastName}}

### Create a new actor
POST http://localhost:3000/actors
Content-Type: application/json

{
  "firstName": "Leonardo",
  "lastName": "DiCaprio",
  "birthdate": "1974-11-11",
  "country": "USA",
  "movies": ["Inception", "Titanic"]
}

### Update an actor by ID
PUT http://localhost:3000/actors/{{actorId}}
Content-Type: application/json

{
  "firstName": "Leonardo",
  "lastName": "DiCaprio",
  "birthdate": "1974-11-11",
  "country": "USA",
  "movies": ["Inception", "Titanic"]
}

### Delete an actor by ID
DELETE http://localhost:3000/actors/{{actorId}}

